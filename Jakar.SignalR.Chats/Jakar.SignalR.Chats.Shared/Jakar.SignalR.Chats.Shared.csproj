    <PropertyGroup>
        <PackageId>Jakar.SignalR.Chats.Shared</PackageId>
        <Version>10.1.0-alpha.1</Version>
        <Description>The models and strongly typed contracts (IChatHub, IChatClient) shared by the Jakar.SignalR.Chats chat client and server.</Description>
        <PackageTags>signalr chat realtime hub contracts</PackageTags>
